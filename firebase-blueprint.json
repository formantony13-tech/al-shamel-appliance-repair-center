        "lastBookingDate": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["id", "name", "phone", "address", "totalBookings", "createdAt", "updatedAt"]
    },
    "repair": {
