{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "Customer appliance repair booking record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier (e.g. BK-2026-12345)"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Egyptian phone number"
        },
        "address": {
          "type": "string",
          "description": "Customer location or village in Abu El Matamir"
        },
        "deviceType": {
          "type": "string",
          "description": "Appliance category or type"
        },
        "brand": {
          "type": "string",
          "description": "Appliance brand"
        },
        "issueDescription": {
          "type": "string",
          "description": "Details of the problem"
        },
        "preferredTime": {
          "type": "string",
          "description": "Preferred service visit time"
        },
        "status": {
          "type": "string",
          "enum": ["NEW", "CONTACTED", "SCHEDULED", "ASSIGNED", "IN_PROGRESS", "WAITING_FOR_PART", "COMPLETED", "CANCELLED"],
          "description": "Current lifecycle status of the booking"
        },
        "notes": {
          "type": "string",
          "description": "Internal technician notes"
        },
        "technicianName": {
          "type": "string",
          "description": "Assigned technician name"
        },
        "estimatedCost": {
          "type": "number",
          "description": "Estimated repair price"
        },
        "imageUrl": {
          "type": "string",
          "description": "Uploaded fault image URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "fullName", "phoneNumber", "address", "deviceType", "issueDescription", "status", "createdAt", "updatedAt"]
    },
    "customer": {
      "title": "Customer",
