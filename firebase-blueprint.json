        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "booking_tracking": {
      "title": "BookingTracking",
      "description": "Safe, non-PII public status tracking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "deviceType": { "type": "string" },
        "phoneLast4": { "type": "string" },
        "stage": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "status", "deviceType", "phoneLast4", "stage", "createdAt", "updatedAt"]
    },
    "audit_log": {
      "title": "AuditLog",
      "description": "Append-only administrative action audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": { "type": "object" },
        "targetId": { "type": "string" },
        "targetCollection": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "performedBy", "targetId", "targetCollection", "details", "timestamp"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Authorized administrative accounts"
    },
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Appliance repair bookings collection (Admin only read)"
    },
    "/booking_tracking/{trackingId}": {
      "schema": "booking_tracking",
      "description": "Privacy-first public tracking records"
    },
    "/audit_logs/{logId}": {
      "schema": "audit_log",
      "description": "Tamper-proof append-only administrative audit trail"
    },
    "/customers/{customerId}": {
      "schema": "customer",
      "description": "Private customer CRM collection (Admin only)"
    },
    "/repairs/{repairId}": {
      "schema": "repair",
      "description": "Technical worksheets and repair jobs collection (Admin only)"
    },
    "/works/{workId}": {
      "schema": "work",
      "description": "Repairs showcase gallery collection (Public read, Admin write)"
    },
    "/for_sale/{itemId}": {
      "schema": "for_sale_item",
      "description": "Certified appliances for sale marketplace (Public read, Admin write)"
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Customer reviews and testimonials collection (Moderated)"
    },
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "Public website customization and branding settings (Admin write)"
    }
  }
}
